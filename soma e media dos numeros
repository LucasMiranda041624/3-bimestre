programa
{
	funcao inicio()
	{
		real numero, soma = 0.0, media
		inteiro i

		
		para (i = 1; i <= 5; i++)
		{
			escreva("Digite o ", i, "º número: ")
			leia(numero)
			
			
			soma = soma + numero
		}

		
		media = soma / 5
		escreva("\n---------------------------")
		escreva("\nA soma dos números é: ", soma)
		escreva("\nA média dos números é: ", media)
		escreva("\n---------------------------\n")
	}
}
