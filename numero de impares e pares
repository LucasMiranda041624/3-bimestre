programa
{
	funcao inicio()
	{
		inteiro numero, i
		inteiro pares = 0, impares = 0

		
		para (i = 1; i <= 5; i++)
		{
			escreva("Digite o ", i, " número inteiro: ")
			leia(numero)

			se (numero % 2 == 0)
			{
				pares++   
			}
			senao
			{
				impares++  
			}
		}

		escreva("\n---------------------------")
		escreva("\nQuantidade de números pares: ", pares)
		escreva("\nQuantidade de números ímpares: ", impares)
		escreva("\n---------------------------\n")
	}
}
