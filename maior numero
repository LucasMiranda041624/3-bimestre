programa
{
	funcao inicio()
	{
		real numero, maior = 0.0
		inteiro i

		para (i = 1; i <= 5; i++)
		{
			escreva("Digite o ", i, "º número: ")
			leia(numero)
      
			se (i == 1)
			{
				maior = numero
			}
			senao
			{
				
				se (numero > maior)
				{
					maior = numero
				}
			}
		}

		escreva("\n---------------")
		escreva("\nO maior número digitado foi: ", maior)
		escreva("\n---------------\n")
	}
}
